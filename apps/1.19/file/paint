#!/bin/lua
-- paint - a small drawing pad on graphics.canvas.
--
-- Demonstrates callback mode: the canvas keeps its buffer between frames, so
-- every stroke stays on screen and each change only asks for a repaint.
--
-- Usage:
--   paint          draw with the stylus (touch devices) or the keypad
--   paint 1        draw a demo pattern and return (used by the test suite)
--
-- Keypad: arrows move the pen, FIRE lifts/lowers the pen,
--         1 / 3 change the brush size, 5 changes the color, 0 clears.

local PALETTE = { 0x000000, 0xFF3030, 0x30C030, 0x3060FF, 0xFFAA00, 0xB040C0, 0x00B0B0, 0x808080, 0xFFFFFF }
local TOOLBAR = 26

local c = graphics.canvas.new({
    title = "Paint",
    background = 0xFFFFFF,
    foreground = 0x000000,
    font = "monospace medium"
})

local W, H = c:size()
local key, action = graphics.canvas.key, graphics.canvas.action

local state = {
    colorIndex = 1,
    size = 2,
    x = W / 2 - (W / 2) % 1,
    y = (H - TOOLBAR) / 2 - ((H - TOOLBAR) / 2) % 1,
    lastX = nil,
    lastY = nil,
    pen = true,
    strokes = 0
}

local function currentColor() return PALETTE[state.colorIndex] end

local function clampY(y)
    if y < 0 then return 0 end
    if y > H - TOOLBAR - 1 then return H - TOOLBAR - 1 end
    return y
end

local function clampX(x)
    if x < 0 then return 0 end
    if x > W - 1 then return W - 1 end
    return x
end

-- A thick line: draw the same segment offset around the center line.
local function stroke(x1, y1, x2, y2)
    c:color(currentColor())
    local s = state.size - 1
    for i = -s, s do
        for j = -s, s do
            c:line(x1 + i, y1 + j, x2 + i, y2 + j)
        end
    end
    state.strokes = state.strokes + 1
end

local function dot(x, y)
    c:color(currentColor())
    c:circle(x, y, state.size, true)
    state.strokes = state.strokes + 1
end

local function drawToolbar()
    c:color(0x101820)
    c:rect(0, H - TOOLBAR, W, TOOLBAR, true)

    local x = 4
    for i = 1, #PALETTE do
        c:color(PALETTE[i])
        c:rect(x, H - TOOLBAR + 5, 14, 14, true)
        if i == state.colorIndex then
            c:color(0xFFFFFF)
            c:rect(x - 1, H - TOOLBAR + 4, 16, 16, false)
        end
        x = x + 18
    end

    c:color(0xFFFFFF)
    c:font("monospace medium")
    c:text("size " .. state.size, W - 4, H - TOOLBAR + 7, "right")
end

local function clearAll()
    c:clear()
    c:color(0x909090)
    c:text("draw: stylus or arrows", 6, 6)
    state.strokes = 0
    drawToolbar()
    c:repaint()
end

local function moveBy(dx, dy)
    local nx, ny = clampX(state.x + dx), clampY(state.y + dy)
    if state.pen then stroke(state.x, state.y, nx, ny) end
    state.x = nx
    state.y = ny
    c:repaint()
end

local function setColor(index)
    state.colorIndex = (index - 1) % #PALETTE + 1
    drawToolbar()
    c:repaint()
end

local function setSize(delta)
    local size = state.size + delta
    if size < 1 then size = 1 end
    if size > 6 then size = 6 end
    state.size = size
    drawToolbar()
    c:repaint()
end

-- Pointer (stylus / touch)
c.pointerPressed = function(canvas, x, y)
    state.lastX = clampX(x)
    state.lastY = clampY(y)
    state.x = state.lastX
    state.y = state.lastY
    dot(state.x, state.y)
    c:repaint()
end

c.pointerDragged = function(canvas, x, y)
    local nx, ny = clampX(x), clampY(y)
    if state.lastX ~= nil then stroke(state.lastX, state.lastY, nx, ny) end
    state.lastX = nx
    state.lastY = ny
    state.x = nx
    state.y = ny
    c:repaint()
end

c.pointerReleased = function(canvas, x, y)
    state.lastX = nil
    state.lastY = nil
end

-- Keypad
c.keyPressed = function(canvas, k, a)
    if a == action.UP then moveBy(0, -8)
    elseif a == action.DOWN then moveBy(0, 8)
    elseif a == action.LEFT then moveBy(-8, 0)
    elseif a == action.RIGHT then moveBy(8, 0)
    elseif a == action.FIRE then state.pen = not state.pen
    elseif k == key.NUM1 then setSize(-1)
    elseif k == key.NUM3 then setSize(1)
    elseif k == key.NUM5 then setColor(state.colorIndex + 1)
    elseif k == key.NUM0 then clearAll()
    end
end

local function demo()
    -- Deterministic pattern so the test suite can exercise the brushes.
    local cx, cy = W / 2, (H - TOOLBAR) / 2
    for i = 1, 40 do
        local a = i * 0.35
        local x = cx + a * 2.2 * math.random(3)
        local y = cy + a * 1.6
        state.colorIndex = (i - 1) % #PALETTE + 1
        state.size = 1 + i % 4
        stroke(clampX(x), clampY(y), clampX(x + 6), clampY(y + 4))
    end
    drawToolbar()
    c:repaint()
end

os.setproc("name", "paint")
clearAll()

c:command("Exit", "exit", function() c:stop() c:close() end)
c:command("Clear", "screen", function() clearAll() end)
c:command("Color", "screen", function() setColor(state.colorIndex + 1) end)
c:command("Size", "screen", function() setSize(state.size >= 6 and -5 or 1) end)

c:display()

if tonumber(arg[1] or "") then
    demo()
    print("paint: " .. state.strokes .. " strokes, size " .. state.size)
end
