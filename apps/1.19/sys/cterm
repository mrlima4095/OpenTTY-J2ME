#!/bin/lua
-- cterm - a Canvas terminal emulator for OpenTTY.
--
-- Unlike /bin/xterm (an LCDUI Form with a buffer and a text field), cterm
-- paints a real character grid on `graphics.canvas`: ANSI SGR colours
-- (16/256/truecolour), cursor movement, erase sequences, wrapping,
-- scrollback, a coloured prompt and an editable command line with history.
--
-- Keys (phone keypad / desktop shim):
--   Up/Down    scroll the terminal up / down
--   Left/Right move the input cursor
--   FIRE       open the phone text box (123 mode) or run the line (abc mode)
--   Backspace  delete before the cursor   Delete  delete at the cursor
--   Tab        complete a command (/bin) or a path
--   Home / End start / end of the line (GAME_C / GAME_D)
--   PageUp / PageDown page the scrollback (GAME_A / GAME_B)
--
-- Commands (soft keys): Type (phone text box), Send, Switch to... (running
-- apps), Hist (history picker), Clear, Font, QWERTY (abc/123 typing mode) and
-- Exit. Drag with the stylus to scroll the scrollback.
--
-- On a phone the LCDUI event thread must stay free: the whole screen is
-- redrawn only when the grid changes, a key press repaints just the input
-- row, and shell commands run on a background thread (java.run).
--
-- Shell commands run in this process' scope, so `cd` changes the prompt and
-- the next command's directory. Output is captured through io.setstdout and
-- parsed by the terminal engine, so programs that emit ANSI sequences are
-- rendered with colour.
--
-- `cterm 1` draws a deterministic demo frame and returns (used by the test
-- suite). Loading this file with CTERM_AS_MODULE set returns the engine table
-- without starting the app.

local cterm = {}

-- | ANSI 16-colour palette (bright variants included).
local PALETTE = {
    [0] = 0x0C0C0C, [1] = 0xCC0000, [2] = 0x4E9A06, [3] = 0xC4A000,
    [4] = 0x3465A4, [5] = 0x75507B, [6] = 0x06989A, [7] = 0xD3D7CF,
    [8] = 0x555753, [9] = 0xEF2929, [10] = 0x8AE234, [11] = 0xFCE94F,
    [12] = 0x729FCF, [13] = 0xAD7FA8, [14] = 0x34E2E2, [15] = 0xEEEEEC
}

-- | Cell attribute bits.
local AT_BOLD, AT_UNDERLINE, AT_REVERSE, AT_DIM, AT_HIDDEN = 1, 2, 4, 8, 16

local function has(flags, bit)
    return flags % (bit * 2) >= bit
end

local function floor(value)
    return value - value % 1
end

local function clamp(value, low, high)
    if value < low then return low end
    if value > high then return high end
    return value
end

local function splitPlain(text, separator)
    local out = {}
    local start = 1
    while true do
        local position = string.find(text, separator, start, true)
        if position == nil then
            out[#out + 1] = string.sub(text, start)
            return out
        end
        out[#out + 1] = string.sub(text, start, position - 1)
        start = position + 1
    end
end

-- | Byte -> one-character string cache. A cell holds a single character, and
-- | `string.sub(text, i, i)` would allocate a new string for every byte of the
-- | output; with the cache the printable path of `write` allocates nothing.
local CHARS = {}
for byte = 32, 126 do CHARS[byte] = string.char(byte) end

local function charOf(byte)
    local ch = CHARS[byte]
    if ch == nil then
        ch = string.char(byte)
        CHARS[byte] = ch
    end
    return ch
end

-- | A row is sparse: a missing cell means a space in the default colours, so
-- | blank rows (clear, scroll, resize) cost nothing to create and the writer
-- | only pays for the cells it actually touches.
-- | Rows ---------------------------------------------------------------------
-- A row is a string of exactly `cols` characters plus a list of styled runs
-- (`{ x, width, fg, bg, at }`). Writing text is a handful of native string
-- operations per run instead of one table store per character: a native call
-- costs ~20 us on the phone, and a screenful of output is a few thousand
-- characters, so the difference is what makes a command feel instant.
local SPACES = {}
local SPACE_BLOCK = ""
for i = 1, 256 do SPACE_BLOCK = SPACE_BLOCK .. " " end

local function spaces(count)
    if count < 1 then return "" end
    local text = SPACES[count]
    if text == nil then
        if count <= 256 then
            text = string.sub(SPACE_BLOCK, 1, count)
        else
            text = SPACE_BLOCK .. spaces(count - 256)
        end
        SPACES[count] = text
    end
    return text
end

local function newRow(cols, fg, bg)
    return { text = spaces(cols), runs = {} }
end

-- | Recompute each run's slice of the row text. Runs are few (one per colour
-- | change), so this keeps the list and the string in sync after any edit.
local function refreshRuns(row)
    local runs = row.runs
    for i = 1, #runs do
        local run = runs[i]
        run.text = string.sub(row.text, run.x, run.x + run.width - 1)
    end
end

-- | Style [from, to], dropping the runs it overlaps. Adjacent runs with the
-- | same style merge, and default (unstyled) cells carry no run at all, so a
-- | plain screen stores nothing.
local function pushRun(kept, run)
    local last = kept[#kept]
    if last ~= nil and last.x + last.width == run.x and
       last.fg == run.fg and last.bg == run.bg and last.at == run.at then
        last.width = last.width + run.width
        last.text = nil
    else
        kept[#kept + 1] = run
    end
end

local function styleRange(row, from, to, fg, bg, at, defFg, defBg)
    local runs = row.runs
    local count = #runs
    local styled = fg ~= defFg or bg ~= defBg or at ~= 0

    -- Appending after the last run is what normal left-to-right output does,
    -- and it needs no rebuild: one merge check and at most one new run.
    local tail = runs[count]
    if tail == nil or tail.x + tail.width - 1 < from then
        if not styled then return end
        if tail ~= nil and tail.fg == fg and tail.bg == bg and tail.at == at
           and tail.x + tail.width == from then
            tail.width = tail.width + to - from + 1
            tail.text = string.sub(row.text, tail.x, tail.x + tail.width - 1)
        else
            runs[count + 1] = { x = from, width = to - from + 1, fg = fg, bg = bg,
                at = at, text = string.sub(row.text, from, to) }
        end
        return
    end

    local kept = {}
    local push = pushRun

    local i, count = 1, #runs
    while i <= count and runs[i].x + runs[i].width - 1 < from do
        push(kept, runs[i])
        i = i + 1
    end
    if i <= count and runs[i].x < from then
        local run = runs[i]
        push(kept, { x = run.x, width = from - run.x, fg = run.fg, bg = run.bg, at = run.at })
        i = i + 1
    end
    if styled then
        push(kept, { x = from, width = to - from + 1, fg = fg, bg = bg, at = at })
    end
    while i <= count and runs[i].x <= to do
        local run = runs[i]
        local runEnd = run.x + run.width - 1
        if runEnd > to then
            push(kept, { x = to + 1, width = runEnd - to, fg = run.fg, bg = run.bg, at = run.at })
        end
        i = i + 1
    end
    while i <= count do
        push(kept, runs[i])
        i = i + 1
    end
    row.runs = kept
    refreshRuns(row)
end

-- | Replace [x, x + #segment - 1] with `segment` in the given style.
local function rowWrite(row, x, segment, fg, bg, at, defFg, defBg, cols)
    local width = #segment
    if width < 1 then return end
    local last = x + width - 1
    if last > cols then
        width = cols - x + 1
        if width < 1 then return end
        segment = string.sub(segment, 1, width)
        last = cols
    end
    local text = row.text
    row.text = string.sub(text, 1, x - 1) .. segment .. string.sub(text, last + 1)
    local runs = row.runs
    local count = #runs
    if count == 0 then
        if fg ~= defFg or bg ~= defBg or at ~= 0 then
            runs[1] = { x = x, width = width, fg = fg, bg = bg, at = at, text = segment }
        end
        return
    end
    -- Overwriting exactly one existing run (a redraw, a spinner, a progress
    -- bar) only updates that run; the list keeps its shape.
    for i = 1, count do
        local run = runs[i]
        if run.x == x and run.width == width then
            if fg == defFg and bg == defBg and at == 0 then
                table.remove(runs, i)
            else
                run.fg = fg
                run.bg = bg
                run.at = at
                run.text = segment
            end
            return
        end
        if run.x > x then break end
    end
    styleRange(row, x, last, fg, bg, at, defFg, defBg)
end

-- | Move the runs at or after `from` by `delta` columns (insert/delete chars),
-- | splitting the run that crosses `from` and clamping to the row.
local function shiftRuns(row, from, delta, cols)
    local runs = row.runs
    local kept = {}
    for i = 1, #runs do
        local run = runs[i]
        local runEnd = run.x + run.width - 1
        local x, e
        if runEnd < from then
            x, e = run.x, runEnd
        elseif run.x >= from then
            x, e = run.x + delta, runEnd + delta
        else
            kept[#kept + 1] = { x = run.x, width = from - run.x, fg = run.fg, bg = run.bg, at = run.at }
            x, e = from + delta, runEnd + delta
        end
        if x < 1 then x = 1 end
        if e > cols then e = cols end
        if e >= x then
            kept[#kept + 1] = { x = x, width = e - x + 1, fg = run.fg, bg = run.bg, at = run.at }
        end
    end
    row.runs = kept
end

-- Parsed CSI parameter lists, keyed by the raw parameter string: coloured
-- output repeats the same SGR sequences line after line, so parsing them once
-- (two splitPlain passes and a tonumber per parameter) pays for itself.
local PARAM_CACHE, PARAM_CACHE_SIZE = {}, 0

local CUBE = { 0, 95, 135, 175, 215, 255 }

-- Map a 256-colour index to the 16-colour palette or to a truecolour value.
local function colour256(index)
    if index == nil or index < 0 then index = 0 end
    if index < 16 then return index end
    if index >= 232 then
        local level = 8 + (index - 232) * 10
        local rgb = level * 65536 + level * 256 + level
        return -(rgb + 1)
    end
    local value = index - 16
    local r = floor(value / 36)
    local g = floor((value % 36) / 6)
    local b = value % 6
    r = CUBE[r + 1]
    g = CUBE[g + 1]
    b = CUBE[b + 1]
    return -((r * 65536 + g * 256 + b) + 1)
end

-- | Terminal engine. It has no dependency on graphics.canvas, so the grid,
-- | parser and line editor can be exercised without a screen.
local Terminal = {}
Terminal.__index = Terminal

function cterm.new(options)
    options = options or {}
    local self = setmetatable({}, Terminal)
    self.cols = options.cols or 80
    self.rows = options.rows or 24
    self.defaultFg = options.fg or 7
    self.defaultBg = options.bg or 0
    self.scrollbackLimit = options.scrollback or 200
    self.historyLimit = options.history or 200
    self.palette = options.palette or PALETTE
    self.grid = {}
    self.scrollback = {}
    self.history = {}
    self.viewOffset = 0
    self.cursorVisible = true
    self.cx = 1
    self.cy = 1
    self.esc = nil
    self.escBuf = ""
    self.savedCx = 1
    self.savedCy = 1
    self.input = ""
    self.cursor = 1
    self.histIndex = 0
    self.savedInput = ""
    -- Bumped by every cell mutation so the canvas only redraws the grid when
    -- it actually changed (a full grid redraw is expensive on real phones).
    self.revision = 0
    self:resetAttrs()
    self:clear()
    return self
end

function Terminal:touch()
    self.revision = self.revision + 1
end

function Terminal:blankRowFor(cols)
    return newRow(cols, self.defaultFg, self.defaultBg)
end

function Terminal:blankRow()
    return self:blankRowFor(self.cols)
end

-- | Attributes live in one number (`self.bits`), so a whole SGR state is
-- | (fg, bg, bits) and can be cached as a triple. The bits are set and cleared
-- | with plain arithmetic: `bits % (2 * bit) < bit` tests whether it is set.
function Terminal:resetAttrs()
    self.fg = self.defaultFg
    self.bg = self.defaultBg
    self.bits = 0
end

function Terminal:clear()
    self:touch()
    self.grid = {}
    for y = 1, self.rows do
        self.grid[y] = self:blankRow()
    end
    self.cx = 1
    self.cy = 1
    self.viewOffset = 0
    self.esc = nil
    self.escBuf = ""
end

function Terminal:clearScrollback()
    self:touch()
    self.scrollback = {}
    self.viewOffset = 0
end

function Terminal:scroll()
    self:touch()
    local top = table.remove(self.grid, 1)
    if top ~= nil then
        self.scrollback[#self.scrollback + 1] = top
        if #self.scrollback > self.scrollbackLimit then
            table.remove(self.scrollback, 1)
        end
    end
    self.grid[self.rows] = self:blankRow()
end

function Terminal:lineFeed()
    if self.cy >= self.rows then
        self:scroll()
    else
        self.cy = self.cy + 1
    end
end

function Terminal:putChar(ch)
    if self.cx > self.cols then
        self.cx = 1
        self:lineFeed()
    end
    self:touch()
    rowWrite(self.grid[self.cy], self.cx, ch, self.fg, self.bg, self.bits,
        self.defaultFg, self.defaultBg, self.cols)
    self.cx = self.cx + 1
end

function Terminal:sgr(params)
    local count = #params
    if count == 0 then
        self:resetAttrs()
        return
    end
    local fg, bg, bits = self.fg, self.bg, self.bits
    local i = 1
    while i <= count do
        local code = params[i] or 0
        if code == 0 then
            fg, bg, bits = self.defaultFg, self.defaultBg, 0
        elseif code == 1 then
            if bits % 2 == 0 then bits = bits + AT_BOLD end
        elseif code == 2 then
            if bits % 16 < 8 then bits = bits + AT_DIM end
        elseif code == 4 then
            if bits % 4 < 2 then bits = bits + AT_UNDERLINE end
        elseif code == 7 then
            if bits % 8 < 4 then bits = bits + AT_REVERSE end
        elseif code == 8 then
            if bits % 32 < 16 then bits = bits + AT_HIDDEN end
        elseif code == 21 then
            if bits % 2 >= 1 then bits = bits - AT_BOLD end
        elseif code == 22 then
            if bits % 2 >= 1 then bits = bits - AT_BOLD end
            if bits % 16 >= 8 then bits = bits - AT_DIM end
        elseif code == 24 then
            if bits % 4 >= 2 then bits = bits - AT_UNDERLINE end
        elseif code == 27 then
            if bits % 8 >= 4 then bits = bits - AT_REVERSE end
        elseif code == 28 then
            if bits % 32 >= 16 then bits = bits - AT_HIDDEN end
        elseif code >= 30 and code <= 37 then
            fg = code - 30
        elseif code == 39 then
            fg = self.defaultFg
        elseif code >= 40 and code <= 47 then
            bg = code - 40
        elseif code == 49 then
            bg = self.defaultBg
        elseif code >= 90 and code <= 97 then
            fg = code - 90 + 8
        elseif code >= 100 and code <= 107 then
            bg = code - 100 + 8
        elseif code == 38 or code == 48 then
            local mode = params[i + 1]
            if mode == 5 then
                local value = colour256(params[i + 2] or 0)
                if code == 38 then fg = value else bg = value end
                i = i + 2
            elseif mode == 2 then
                local r = params[i + 2]
                local g = params[i + 3]
                local b = params[i + 4]
                if r == nil then
                    r = params[i + 3]
                    g = params[i + 4]
                    b = params[i + 5]
                    i = i + 1
                end
                local value = -(((r or 0) * 65536 + (g or 0) * 256 + (b or 0)) + 1)
                if code == 38 then fg = value else bg = value end
                i = i + 4
            end
        end
        i = i + 1
    end
    self.fg = fg
    self.bg = bg
    self.bits = bits
end

function Terminal:eraseLine(mode)
    self:touch()
    local from, to
    if mode == 1 then
        from, to = 1, self.cx
    elseif mode == 2 then
        from, to = 1, self.cols
    else
        from, to = self.cx, self.cols
    end
    if from < 1 then from = 1 end
    if to > self.cols then to = self.cols end
    if to < from then return end
    rowWrite(self.grid[self.cy], from, spaces(to - from + 1), self.defaultFg,
        self.defaultBg, 0, self.defaultFg, self.defaultBg, self.cols)
end

function Terminal:eraseDisplay(mode)
    self:touch()
    -- Whole rows are replaced by blank ones instead of being cleared cell by
    -- cell: a sparse row is free, a cols-wide loop is not.
    if mode == 1 then
        self:eraseLine(1)
        for y = 1, self.cy - 1 do
            self.grid[y] = self:blankRow()
        end
    elseif mode == 2 or mode == 3 then
        for y = 1, self.rows do
            self.grid[y] = self:blankRow()
        end
        if mode == 3 then self.scrollback = {} end
    else
        self:eraseLine(0)
        for y = self.cy + 1, self.rows do
            self.grid[y] = self:blankRow()
        end
    end
end

function Terminal:insertLines(count)
    if count > self.rows - self.cy + 1 then count = self.rows - self.cy + 1 end
    if count < 1 then return end
    self:touch()
    for y = self.rows, self.cy + count, -1 do
        self.grid[y] = self.grid[y - count]
    end
    for y = self.cy, self.cy + count - 1 do
        self.grid[y] = self:blankRow()
    end
end

function Terminal:deleteLines(count)
    if count > self.rows - self.cy + 1 then count = self.rows - self.cy + 1 end
    if count < 1 then return end
    self:touch()
    for y = self.cy, self.rows - count do
        self.grid[y] = self.grid[y + count]
    end
    for y = self.rows - count + 1, self.rows do
        self.grid[y] = self:blankRow()
    end
end

function Terminal:deleteChars(count)
    local cols = self.cols
    if count > cols - self.cx + 1 then count = cols - self.cx + 1 end
    if count < 1 then return end
    self:touch()
    local row = self.grid[self.cy]
    local text = row.text
    row.text = string.sub(text, 1, self.cx - 1) .. string.sub(text, self.cx + count) .. spaces(count)
    shiftRuns(row, self.cx + count, -count, cols)
    styleRange(row, cols - count + 1, cols, self.defaultFg, self.defaultBg, 0, self.defaultFg, self.defaultBg)
end

function Terminal:insertChars(count)
    local cols = self.cols
    if count > cols - self.cx + 1 then count = cols - self.cx + 1 end
    if count < 1 then return end
    self:touch()
    local row = self.grid[self.cy]
    local text = row.text
    row.text = string.sub(text, 1, self.cx - 1) .. spaces(count) .. string.sub(text, self.cx, cols - count)
    shiftRuns(row, self.cx, count, cols)
    styleRange(row, self.cx, self.cx + count - 1, self.defaultFg, self.defaultBg, 0, self.defaultFg, self.defaultBg)
end

-- | SGR state cache. Coloured output repeats the same handful of sequences on
-- | every line, always from the same state, so remembering (fg, bg, bits)
-- | before and after a sequence turns a parse into a table lookup. Each
-- | sequence keeps the last few transitions it was seen with, because a reset
-- | can follow different attributes.
local SGR_CACHE, SGR_CACHE_SIZE = {}, 0

function Terminal:handleCSI(buffer, final)
    if final == "m" then
        local entries = SGR_CACHE[buffer]
        if entries ~= nil then
            local fg, bg, bits = self.fg, self.bg, self.bits
            for k = 1, #entries do
                local entry = entries[k]
                if entry[1] == fg and entry[2] == bg and entry[3] == bits then
                    self.fg = entry[4]
                    self.bg = entry[5]
                    self.bits = entry[6]
                    return
                end
            end
        end
    end

    local private = false
    local first = string.sub(buffer, 1, 1)
    if first == "?" or first == ">" or first == "!" then
        private = true
        buffer = string.sub(buffer, 2)
    end

    local params = PARAM_CACHE[buffer]
    if params == nil then
        params = {}
        if buffer ~= "" then
            local parts = splitPlain(buffer, ";")
            for i = 1, #parts do
                local sub = splitPlain(parts[i], ":")
                for j = 1, #sub do
                    params[#params + 1] = tonumber(sub[j])
                end
            end
        end
        if PARAM_CACHE_SIZE >= 256 then
            PARAM_CACHE = {}
            PARAM_CACHE_SIZE = 0
        end
        PARAM_CACHE[buffer] = params
        PARAM_CACHE_SIZE = PARAM_CACHE_SIZE + 1
    end

    local firstParam = params[1]
    local count = firstParam or 1
    if count < 1 then count = 1 end

    if final == "m" then
        local fg, bg, bits = self.fg, self.bg, self.bits
        self:sgr(params)
        local entries = SGR_CACHE[buffer]
        if entries == nil then
            if SGR_CACHE_SIZE >= 256 then
                SGR_CACHE, SGR_CACHE_SIZE = {}, 0
            end
            entries = {}
            SGR_CACHE[buffer] = entries
            SGR_CACHE_SIZE = SGR_CACHE_SIZE + 1
        end
        local used = #entries
        if used >= 4 then
            entries[1], entries[2], entries[3] = entries[2], entries[3], entries[4]
            used = 3
        end
        entries[used + 1] = { fg, bg, bits, self.fg, self.bg, self.bits }
    elseif final == "A" then
        self.cy = clamp(self.cy - count, 1, self.rows)
    elseif final == "B" then
        self.cy = clamp(self.cy + count, 1, self.rows)
    elseif final == "C" then
        self.cx = clamp(self.cx + count, 1, self.cols)
    elseif final == "D" then
        self.cx = clamp(self.cx - count, 1, self.cols)
    elseif final == "E" then
        self.cy = clamp(self.cy + count, 1, self.rows)
        self.cx = 1
    elseif final == "F" then
        self.cy = clamp(self.cy - count, 1, self.rows)
        self.cx = 1
    elseif final == "G" then
        self.cx = clamp(count, 1, self.cols)
    elseif final == "d" then
        self.cy = clamp(count, 1, self.rows)
    elseif final == "H" or final == "f" then
        self.cy = clamp(params[1] or 1, 1, self.rows)
        self.cx = clamp(params[2] or 1, 1, self.cols)
    elseif final == "J" then
        self:eraseDisplay(params[1] or 0)
    elseif final == "K" then
        self:eraseLine(params[1] or 0)
    elseif final == "L" then
        self:insertLines(count)
    elseif final == "M" then
        self:deleteLines(count)
    elseif final == "P" then
        self:deleteChars(count)
    elseif final == "@" then
        self:insertChars(count)
    elseif final == "X" then
        local last = clamp(self.cx + count - 1, self.cx, self.cols)
        rowWrite(self.grid[self.cy], self.cx, spaces(last - self.cx + 1), self.defaultFg,
            self.defaultBg, 0, self.defaultFg, self.defaultBg, self.cols)
    elseif final == "S" then
        for i = 1, count do self:scroll() end
    elseif final == "T" then
        for i = 1, count do
            table.remove(self.grid, self.rows)
            table.insert(self.grid, 1, self:blankRow())
        end
    elseif final == "s" then
        self.savedCx = self.cx
        self.savedCy = self.cy
    elseif final == "u" then
        self.cx = clamp(self.savedCx, 1, self.cols)
        self.cy = clamp(self.savedCy, 1, self.rows)
    elseif final == "h" or final == "l" then
        if private and (params[1] or 0) == 25 then
            self.cursorVisible = final == "h"
        end
    end
end

-- | Next byte that `write` has to handle one by one, or n + 1 when the rest
-- | of the text is plain. `extra` also looks for CR/BS/TAB, which most output
-- | does not contain.
local function nextControl(text, from, n, extra)
    local stop = n + 1
    local found = string.find(text, "\n", from, true)
    if found ~= nil and found < stop then stop = found end
    found = string.find(text, "\27", from, true)
    if found ~= nil and found < stop then stop = found end
    if extra then
        found = string.find(text, "\t", from, true)
        if found ~= nil and found < stop then stop = found end
        found = string.find(text, "\r", from, true)
        if found ~= nil and found < stop then stop = found end
        found = string.find(text, "\b", from, true)
        if found ~= nil and found < stop then stop = found end
    end
    return stop
end

-- | Position and byte of the final byte of a CSI sequence (0x40..0x7E). One
-- | `string.byte` call covers eight characters, and the scan itself is plain
-- | Lua comparisons, so a colour sequence costs a couple of native calls
-- | instead of one per parameter character. Returns nil when the text ends
-- | before the sequence does.
local function csiFinal(text, from, n)
    local j = from
    while j <= n do
        local e = j + 7
        if e > n then e = n end
        local b1, b2, b3, b4, b5, b6, b7, b8 = string.byte(text, j, e)
        if b1 >= 64 then return j, b1 end
        if b2 ~= nil and b2 >= 64 then return j + 1, b2 end
        if b3 ~= nil and b3 >= 64 then return j + 2, b3 end
        if b4 ~= nil and b4 >= 64 then return j + 3, b4 end
        if b5 ~= nil and b5 >= 64 then return j + 4, b5 end
        if b6 ~= nil and b6 >= 64 then return j + 5, b6 end
        if b7 ~= nil and b7 >= 64 then return j + 6, b7 end
        if b8 ~= nil and b8 >= 64 then return j + 7, b8 end
        j = j + 8
    end
    return nil
end

function Terminal:write(text)
    text = tostring(text or "")
    local n = #text
    if n == 0 then return end
    -- One revision bump per write instead of one per character: the canvas only
    -- needs to know that the grid changed.
    self:touch()

    local extra = string.find(text, "\t", 1, true) ~= nil
        or string.find(text, "\r", 1, true) ~= nil
        or string.find(text, "\b", 1, true) ~= nil
    local cols = self.cols
    local i = 1
    while i <= n do
        local esc = self.esc
        if esc == nil then
            local stop = nextControl(text, i, n, extra)
            if stop > i then
                self:writeText(string.sub(text, i, stop - 1))
                i = stop
            end
            if i <= n then
                local byte = string.byte(text, i)
                if byte == 27 then
                    -- Consume the introducer in the same step: the next byte
                    -- decides whether this is CSI, OSC or a two-byte escape.
                    local after = string.byte(text, i + 1)
                    if after == 91 then
                        self.esc = "csi"
                        self.escBuf = ""
                        i = i + 2
                    elseif after == 93 then
                        self.esc = "osc"
                        i = i + 2
                    elseif after == nil then
                        self.esc = "esc"
                        i = i + 1
                    else
                        self.esc = nil
                        i = i + 2
                    end
                elseif byte == 10 then
                    self:lineFeed()
                    self.cx = 1
                    i = i + 1
                elseif byte == 13 then
                    self.cx = 1
                    i = i + 1
                elseif byte == 8 then
                    if self.cx > 1 then self.cx = self.cx - 1 end
                    i = i + 1
                elseif byte == 9 then
                    local stopColumn = (floor((self.cx - 1) / 8) + 1) * 8 + 1
                    self.cx = clamp(stopColumn, 1, cols)
                    i = i + 1
                else
                    -- BEL and the other C0 controls are ignored.
                    i = i + 1
                end
            end
        elseif esc == "csi" then
            local pos, byte = csiFinal(text, i, n)
            if pos == nil then
                -- The sequence continues in the next write: keep what we have.
                self.escBuf = self.escBuf .. string.sub(text, i)
                i = n + 1
            else
                local buffer = self.escBuf
                if pos > i then buffer = buffer .. string.sub(text, i, pos - 1) end
                local ch = CHARS[byte]
                if ch == nil then ch = charOf(byte) end
                self:handleCSI(buffer, ch)
                self.esc = nil
                self.escBuf = ""
                i = pos + 1
            end
        elseif esc == "osc" then
            -- Titles and other string sequences are rare, so this stays a
            -- simple byte walk (BEL or ESC \ ends it).
            local byte = string.byte(text, i)
            if byte == 7 then
                self.esc = nil
            elseif byte == 27 and string.byte(text, i + 1) == 92 then
                self.esc = nil
                i = i + 1
            end
            i = i + 1
        else
            -- ESC was the last byte of the previous chunk.
            local byte = string.byte(text, i)
            if byte == 91 then
                self.esc = "csi"
                self.escBuf = ""
            elseif byte == 93 then
                self.esc = "osc"
            else
                self.esc = nil
            end
            i = i + 1
        end
    end
end

-- | Write a plain (control-free) run of text at the cursor, wrapping at the
-- | right margin. Each row segment is one string splice, not a cell loop.
function Terminal:writeText(segment)
    local cols = self.cols
    local i, n = 1, #segment
    while i <= n do
        local cx = self.cx
        if cx > cols then
            self.cx = 1
            self:lineFeed()
            cx = 1
        end
        local room = cols - cx + 1
        local take = n - i + 1
        if take > room then take = room end
        local chunk = take == n and i == 1 and segment or string.sub(segment, i, i + take - 1)
        rowWrite(self.grid[self.cy], cx, chunk, self.fg, self.bg, self.bits,
            self.defaultFg, self.defaultBg, cols)
        self.cx = cx + take
        i = i + take
    end
end

function Terminal:rowText(row)
    return row.text
end

function Terminal:screenText()
    local lines = {}
    for y = 1, self.rows do
        lines[y] = self.grid[y].text
    end
    return table.concat(lines, "\n")
end

function Terminal:scrollbackText()
    local lines = {}
    for y = 1, #self.scrollback do
        lines[y] = self.scrollback[y].text
    end
    return table.concat(lines, "\n")
end

function Terminal:allText()
    local lines = {}
    for y = 1, #self.scrollback do
        lines[#lines + 1] = self.scrollback[y].text
    end
    for y = 1, self.rows do
        lines[#lines + 1] = self.grid[y].text
    end
    return table.concat(lines, "\n")
end

function Terminal:cellAt(x, y)
    local row = self.grid[y]
    if row == nil then return nil end
    if x < 1 or x > #row.text then return nil end
    local ch = string.sub(row.text, x, x)
    local runs = row.runs
    for i = 1, #runs do
        local run = runs[i]
        if x >= run.x and x < run.x + run.width then
            return ch, run.fg, run.bg, run.at
        end
    end
    return ch, self.defaultFg, self.defaultBg, 0
end

function Terminal:viewRows()
    local out = {}
    local offset = self.viewOffset
    if offset > #self.scrollback then
        offset = #self.scrollback
        self.viewOffset = offset
    end
    local start = #self.scrollback - offset + 1
    for y = 1, self.rows do
        local index = start + y - 1
        if index >= 1 and index <= #self.scrollback then
            out[y] = self.scrollback[index]
        else
            out[y] = self.grid[index - #self.scrollback] or self:blankRow()
        end
    end
    return out
end

function Terminal:scrollUp(count)
    if count == nil or count < 1 then count = 1 end
    self.viewOffset = clamp(self.viewOffset + count, 0, #self.scrollback)
end

function Terminal:scrollDown(count)
    if count == nil or count < 1 then count = 1 end
    self.viewOffset = clamp(self.viewOffset - count, 0, #self.scrollback)
end

function Terminal:bottom()
    self.viewOffset = 0
end

function Terminal:setInput(text)
    self.input = text or ""
    self.cursor = #self.input + 1
end

function Terminal:insertChar(ch)
    self.input = string.sub(self.input, 1, self.cursor - 1) .. ch .. string.sub(self.input, self.cursor)
    self.cursor = self.cursor + 1
end

function Terminal:insertText(text)
    if text == nil or text == "" then return end
    self.input = string.sub(self.input, 1, self.cursor - 1) .. text .. string.sub(self.input, self.cursor)
    self.cursor = self.cursor + #text
end

function Terminal:backspaceInput()
    if self.cursor > 1 then
        self.input = string.sub(self.input, 1, self.cursor - 2) .. string.sub(self.input, self.cursor)
        self.cursor = self.cursor - 1
    end
end

function Terminal:deleteInput()
    if self.cursor <= #self.input then
        self.input = string.sub(self.input, 1, self.cursor - 1) .. string.sub(self.input, self.cursor + 1)
    end
end

function Terminal:moveInput(delta)
    self.cursor = clamp(self.cursor + delta, 1, #self.input + 1)
end

function Terminal:moveHome()
    self.cursor = 1
end

function Terminal:moveEnd()
    self.cursor = #self.input + 1
end

function Terminal:pushHistory(command)
    if command == nil or command == "" then return end
    if #self.history == 0 or self.history[#self.history] ~= command then
        self.history[#self.history + 1] = command
        if #self.history > self.historyLimit then
            table.remove(self.history, 1)
        end
    end
    self.histIndex = 0
    self.savedInput = ""
end

function Terminal:historyPrev()
    if #self.history == 0 then return end
    if self.histIndex == 0 then
        self.savedInput = self.input
        self.histIndex = #self.history
    elseif self.histIndex > 1 then
        self.histIndex = self.histIndex - 1
    end
    self.input = self.history[self.histIndex]
    self.cursor = #self.input + 1
end

function Terminal:historyNext()
    if self.histIndex == 0 then return end
    if self.histIndex < #self.history then
        self.histIndex = self.histIndex + 1
        self.input = self.history[self.histIndex]
    else
        self.histIndex = 0
        self.input = self.savedInput or ""
    end
    self.cursor = #self.input + 1
end

function Terminal:submit()
    local command = self.input
    self.input = ""
    self.cursor = 1
    self.histIndex = 0
    self.savedInput = ""
    return command
end

function Terminal:resize(cols, rows)
    if cols == self.cols and rows == self.rows then return end
    self:touch()
    local old = self.grid
    local oldRows, oldCols = self.rows, self.cols
    local dropped = oldRows - rows
    if dropped > 0 then
        for y = 1, dropped do
            self.scrollback[#self.scrollback + 1] = old[y]
        end
        while #self.scrollback > self.scrollbackLimit do
            table.remove(self.scrollback, 1)
        end
    end
    local grid = {}
    for y = 1, rows do
        local sourceY = y
        if dropped > 0 then sourceY = dropped + y end
        local source = old[sourceY]
        local row = self:blankRowFor(cols)
        if source ~= nil then
            local text = source.text
            if oldCols > cols then text = string.sub(text, 1, cols) end
            if cols > #text then text = text .. spaces(cols - #text) end
            row.text = text
            local runs, kept = source.runs, {}
            for i = 1, #runs do
                local run = runs[i]
                if run.x <= cols then
                    local width = run.width
                    if run.x + width - 1 > cols then width = cols - run.x + 1 end
                    kept[#kept + 1] = { x = run.x, width = width, fg = run.fg, bg = run.bg, at = run.at }
                end
            end
            row.runs = kept
            refreshRuns(row)
        end
        grid[y] = row
    end
    self.cols = cols
    self.rows = rows
    self.grid = grid
    self.cx = clamp(self.cx, 1, cols)
    self.cy = clamp(self.cy, 1, rows)
    self.viewOffset = 0
end

function cterm.resolve(value, fallback)
    if value == nil then value = fallback or 7 end
    if value >= 0 then
        local colour = PALETTE[value]
        if colour == nil then colour = PALETTE[fallback or 7] end
        if colour == nil then colour = 0xFFFFFF end
        return colour
    end
    return -value - 1
end

function cterm.dimColor(rgb)
    local r = floor(rgb / 65536) % 256
    local g = floor(rgb / 256) % 256
    local b = rgb % 256
    r = floor(r / 2)
    g = floor(g / 2)
    b = floor(b / 2)
    return r * 65536 + g * 256 + b
end

cterm.palette = PALETTE
cterm.has = has

-- | Canvas application -------------------------------------------------------

local FONTS = { "monospace small", "monospace medium", "monospace large" }
local PAD = 2
local CONFIG = "/home/.ctermrc"
-- The scrollback keeps 200 rows (~16 KB at 80 columns), so parsing more output
-- than that only burns CPU on the phone: the extra text scrolls away unseen.
local OUTPUT_LIMIT = 16384
local THEME = {
    bg = 0x0C0C0C,
    fg = 0xD3D7CF,
    inputBg = 0x161616,
    cursor = 0xD3D7CF,
    cursorText = 0x0C0C0C,
    scroll = 0xFCE94F,
    dim = 0x6E7069
}

-- | Remember the input mode across runs. `io.read`/`io.write` are wrapped in
-- | pcall because /home may be read-only in a chroot.
local function readQwerty()
    local text = nil
    pcall(function() text = io.read(CONFIG) end)
    if type(text) ~= "string" then return false end
    if string.find(text, "qwerty=1", 1, true) ~= nil then return true end
    return false
end

local function writeQwerty(value)
    pcall(io.write, "qwerty=" .. (value and "1" or "0") .. "\n", CONFIG)
end

local function run(options)
    options = options or {}
    pcall(os.setproc, "name", "cterm")

    local c = graphics.canvas.new({
        title = options.title or "cterm",
        background = THEME.bg,
        foreground = THEME.fg,
        font = FONTS[1]
    })
    local action = graphics.canvas.action

    local fontIndex = 1
    if options.font ~= nil then
        for i = 1, #FONTS do
            if FONTS[i] == options.font then fontIndex = i end
        end
    end

    local W, H = 0, 0
    local charW, lineH = 6, 12
    local cols, rows = 80, 24
    local t = nil
    local app = nil
    local dragging = nil
    local busy = false
    local qwerty = readQwerty()
    local promptCache = nil
    local hostCache = nil
    local drawnRevision = nil
    local drawnOffset = nil
    local drawnRows, drawnCols = nil, nil
    local drawnInput = nil

    -- | Colour caches: `cterm.resolve` and `cterm.dimColor` are pure functions
    -- | of the palette, so resolving a value once per frame becomes a lookup.
    local COLOURS, DIMS = {}, {}
    local function colourOf(value)
        local rgb = COLOURS[value]
        if rgb == nil then
            rgb = cterm.resolve(value, t.defaultFg)
            COLOURS[value] = rgb
        end
        return rgb
    end
    local function dimOf(rgb)
        local dim = DIMS[rgb]
        if dim == nil then
            dim = cterm.dimColor(rgb)
            DIMS[rgb] = dim
        end
        return dim
    end

    local function hostName()
        if hostCache == nil then
            local text = nil
            pcall(function() text = io.read("/etc/hostname") end)
            if type(text) == "string" then text = string.trim(text) end
            if type(text) ~= "string" or text == "" then text = "localhost" end
            hostCache = text
        end
        return hostCache
    end

    local function measure()
        W, H = c:size()
        c:font(FONTS[fontIndex])
        local width = c:charWidth("M")
        if type(width) ~= "number" or width < 1 then width = 6 end
        charW = width
        local height = c:metrics()
        if type(height) ~= "number" or height < 1 then height = charW + 2 end
        lineH = height
        cols = floor((W - PAD * 2) / charW)
        rows = floor((H - PAD * 2 - lineH) / lineH)
        if cols < 4 then cols = 4 end
        if rows < 1 then rows = 1 end
        promptCache = nil
    end

    measure()
    if options.cols ~= nil then cols = options.cols end
    if options.rows ~= nil then rows = options.rows end

    t = cterm.new({
        cols = cols,
        rows = rows,
        scrollback = options.scrollback or 200,
        history = options.history or 200
    })

    -- | Prompt segments, measured with textWidth instead of `#text * charW`:
    -- | some phones fall back to a proportional font for "monospace", where a
    -- | per-character advance leaves a huge gap between user, @ and host.
    local function promptInfo()
        if promptCache ~= nil then return promptCache end

        local scope = os.scope() or {}
        local user = scope["USER"] or "user"
        local host = hostName()
        local pwd = os.getcwd() or "/"
        local mark = os.getuid() == 0 and "#" or "$"
        local tail = mark .. " "
        local limit = floor(t.cols * charW * 0.6)
        if limit < 1 then limit = 1 end

        local function width(list)
            local total = 0
            for i = 1, #list do total = total + c:textWidth(list[i].text) end
            return total
        end

        local segments = {
            { text = user, fg = 10, bold = true },
            { text = "@", fg = 8 },
            { text = host, fg = 14, bold = true },
            { text = ":", fg = 8 },
            { text = pwd, fg = 12, bold = true },
            { text = tail, fg = 11, bold = true }
        }

        -- On a narrow screen the full user@host:path prompt would leave no
        -- room to type, so fall back to the path and then to the marker.
        if width(segments) > limit then
            if c:textWidth(pwd) + c:textWidth(tail) > limit then
                local keep = #pwd
                while keep > 1 do
                    local candidate = "..." .. string.sub(pwd, #pwd - keep + 1)
                    if c:textWidth(candidate) + c:textWidth(tail) <= limit then
                        pwd = candidate
                        break
                    end
                    keep = keep - 1
                end
            end
            segments = {
                { text = pwd, fg = 12, bold = true },
                { text = tail, fg = 11, bold = true }
            }
        end

        local total = 0
        for i = 1, #segments do
            segments[i].width = c:textWidth(segments[i].text)
            total = total + segments[i].width
        end
        promptCache = { segments = segments, width = total }
        return promptCache
    end

    local function promptAnsi()
        local info = promptInfo()
        local out = ""
        for i = 1, #info.segments do
            local segment = info.segments[i]
            local code = "38;5;" .. segment.fg
            if segment.bold then code = "1;" .. code end
            out = out .. "\27[" .. code .. "m" .. segment.text .. "\27[0m"
        end
        return out
    end

    -- | Grid: one fillRect for the background, then each row's styled runs and
    -- | the plain text between them. The runs are maintained by the writer, so
    -- | a repaint (scrolling, a key press, a resize) never scans cells.
    local function drawRow(row, py)
        local runs = row.runs
        local text = row.text
        local defBg = t.defaultBg
        local x = 1
        for i = 1, #runs do
            local run = runs[i]
            if run.x > x then
                local gap = string.sub(text, x, run.x - 1)
                if gap ~= spaces(#gap) then
                    c:color(THEME.fg)
                    c:text(gap, PAD + (x - 1) * charW, py, "left")
                end
            end
            local at = run.at
            local fg, bg = run.fg, run.bg
            if at % 8 >= 4 then fg, bg = bg, fg end -- AT_REVERSE
            if bg ~= defBg then
                c:color(colourOf(bg))
                c:rect(PAD + (run.x - 1) * charW, py, run.width * charW, lineH, true)
            end
            if at % 32 < 16 then -- not AT_HIDDEN
                local colour = colourOf(fg)
                if at % 16 >= 8 then colour = dimOf(colour) end -- AT_DIM
                c:color(colour)
                local tx = PAD + (run.x - 1) * charW
                local runText = run.text
                c:text(runText, tx, py, "left")
                if at % 2 >= 1 then c:text(runText, tx + 1, py, "left") end -- AT_BOLD
                if at % 4 >= 2 then -- AT_UNDERLINE
                    c:line(tx, py + lineH - 1, tx + #runText * charW - 1, py + lineH - 1)
                end
            end
            x = run.x + run.width
        end
        if x <= #text then
            local tail = string.sub(text, x)
            if tail ~= spaces(#tail) then
                c:color(THEME.fg)
                c:text(tail, PAD + (x - 1) * charW, py, "left")
            end
        end
    end

    local function drawGrid()
        local visible = t:viewRows()

        c:color(THEME.bg)
        c:rect(0, PAD, W, t.rows * lineH, true)

        for y = 1, t.rows do
            drawRow(visible[y], PAD + (y - 1) * lineH)
        end

        if t.viewOffset > 0 then
            local label = " SCROLL -" .. t.viewOffset .. " "
            local width = c:textWidth(label) + 4
            local sx = W - width
            if sx < 0 then sx = 0 end
            c:color(0x000000)
            c:rect(sx, 0, width, lineH, true)
            c:color(THEME.scroll)
            c:text(label, W - 2, 0, "right")
        end
    end

    -- | Input row: prompt, editable line, block cursor and the mode marker.
    -- | Redrawn on every key press; it is a handful of calls, unlike the grid.
    local function drawInput(info)
        local y = PAD + t.rows * lineH
        c:color(THEME.inputBg)
        c:rect(0, y, W, lineH, true)

        local x = PAD
        for i = 1, #info.segments do
            local segment = info.segments[i]
            c:color(colourOf(segment.fg))
            c:text(segment.text, x, y, "left")
            if segment.bold then c:text(segment.text, x + 1, y, "left") end
            x = x + segment.width
        end

        local mode = qwerty and "abc" or "123"
        local modeWidth = c:textWidth(mode) + 4
        local startX = PAD + info.width
        local available = floor((W - PAD - startX - modeWidth) / charW)
        if available < 1 then available = 1 end
        local offset = 0
        if t.cursor - 1 > available then offset = t.cursor - 1 - available end
        local text = string.sub(t.input, offset + 1, offset + available)

        c:color(THEME.fg)
        c:text(text, startX, y, "left")

        local before = string.sub(text, 1, t.cursor - 1 - offset)
        local cursorX = startX + c:textWidth(before)
        if cursorX > W - charW then cursorX = W - charW end
        if cursorX < 0 then cursorX = 0 end
        c:color(THEME.cursor)
        c:rect(cursorX, y + 1, charW, lineH - 2, true)
        local under = string.sub(t.input, t.cursor, t.cursor)
        if under ~= "" then
            c:color(THEME.cursorText)
            c:text(under, cursorX, y, "left")
        end

        c:color(THEME.dim)
        c:text(mode, W - PAD, y, "right")
    end

    -- | Redraw what changed and ask for a repaint. Both halves are skipped when
    -- | nothing did: the grid keeps a revision and the input row is keyed by
    -- | (input, cursor, mode, prompt width), so a repeated key that does not
    -- | move anything costs no drawing and no repaint at all.
    local function render(force)
        local needGrid = drawnRevision ~= t.revision or drawnOffset ~= t.viewOffset
            or drawnRows ~= t.rows or drawnCols ~= t.cols
        local info = promptInfo()
        local mode = qwerty and "abc" or "123"
        local inputKey = t.input .. "|" .. t.cursor .. "|" .. mode .. "|" .. info.width
        local needInput = inputKey ~= drawnInput
        if not needGrid and not needInput and not force then return end

        if needGrid then
            drawGrid()
            drawnRevision = t.revision
            drawnOffset = t.viewOffset
            drawnRows = t.rows
            drawnCols = t.cols
        end
        if needInput or force then
            drawInput(info)
            drawnInput = inputKey
        end
        if app ~= nil then
            app.cols = t.cols
            app.rows = t.rows
        end
        c:repaint()
    end

    local function writeHelp()
        t:write("\27[1;36mcterm\27[0m - Canvas terminal emulator\n")
        t:write("\n")
        t:write("\27[1mKeys\27[0m\n")
        t:write("  Up / Down      scroll the terminal\n")
        t:write("  Left / Right   move the input cursor\n")
        t:write("  FIRE           type a command (abc mode: run it)\n")
        t:write("  Backspace      delete before the cursor\n")
        t:write("  Delete         delete at the cursor\n")
        t:write("  Tab            complete a command or a path\n")
        t:write("\n")
        t:write("\27[1mCommands\27[0m\n")
        t:write("  clear          clear the screen and scrollback\n")
        t:write("  colors         show the ANSI colour palette\n")
        t:write("  history        list the command history\n")
        t:write("  qwerty         toggle direct typing (abc/123)\n")
        t:write("  help           this text\n")
        t:write("  exit           close cterm\n")
        t:write("\n")
        t:write("In 123 mode FIRE opens the phone text box; in abc mode it runs\n")
        t:write("the line. Use \27[1mSwitch to...\27[0m for the running apps.\n")
    end

    local function writeColors()
        local names = {
            "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
            "gray", "bright red", "bright green", "bright yellow",
            "bright blue", "bright magenta", "bright cyan", "bright white"
        }
        for row = 0, 1 do
            for i = 0, 7 do
                local index = row * 8 + i
                t:write("\27[48;5;" .. index .. "m  \27[0m")
            end
            t:write("  " .. row .. "\n")
        end
        t:write("\n")
        for i = 0, 15 do
            t:write("\27[38;5;" .. i .. "m" .. names[i + 1] .. "\27[0m\n")
        end
        t:write("\n")
        t:write("\27[1mbold\27[0m \27[4munderline\27[0m \27[7mreverse\27[0m ")
        t:write("\27[2mdim\27[0m \27[38;2;255;128;0mtruecolour\27[0m\n")
    end

    local function writeHistory()
        if #t.history == 0 then
            t:write("history: empty\n")
            return
        end
        for i = 1, #t.history do
            t:write(i .. "  " .. t.history[i] .. "\n")
        end
    end

    local function closeApp()
        c:stop()
        c:close()
    end

    local function setQwerty(value, persist)
        qwerty = value and true or false
        if persist then writeQwerty(qwerty) end
        render()
    end

    local function execute(command)
        command = string.trim(command or "")
        if command == "" then
            render()
            return
        end

        t:pushHistory(command)
        t.viewOffset = 0
        t:write(promptAnsi() .. command .. "\n")

        local name = command
        local space = string.find(command, " ", 1, true)
        if space ~= nil then name = string.sub(command, 1, space - 1) end

        local handled = false
        if name == "clear" then
            t:clear()
            t:clearScrollback()
            handled = true
        elseif name == "help" then
            writeHelp()
            handled = true
        elseif name == "colors" then
            writeColors()
            handled = true
        elseif name == "history" then
            writeHistory()
            handled = true
        elseif name == "qwerty" then
            setQwerty(not qwerty, true)
            handled = true
        elseif name == "exit" or name == "logout" then
            closeApp()
            return
        end

        if not handled then
            local output = io.new()
            local previous = io.stdout
            io.setstdout(output)
            local ok, status = pcall(os.execute, command)
            io.setstdout(previous)
            local text = tostring(output)
            if string.sub(text, 1, 1) == "\n" then text = string.sub(text, 2) end
            if #text > OUTPUT_LIMIT then
                text = string.sub(text, 1, OUTPUT_LIMIT) .. "\n[output truncated]\n"
            end
            if text ~= "" then t:write(text) end
            if not ok then
                t:write("\27[1;31m" .. tostring(status) .. "\27[0m\n")
            end
        end

        if t.cx ~= 1 then t:write("\n") end
        t.viewOffset = 0
        -- The working directory (and maybe the host name) changed.
        promptCache = nil
        hostCache = nil
        -- No c:display() here: this may run on the background thread, and
        -- present() would call Display.setCurrent() off the event thread.
        -- The canvas is already current (FIRE/Send run from it) and render()
        -- posts a coalesced repaint, so only the grid needs updating.
        render()
    end

    -- | Run a command. On a phone the LCDUI event thread must not run the
    -- | shell: a slow command would freeze the whole MIDP event loop, so the
    -- | job is handed to a background thread and the handler returns at once.
    local function runAsync(command)
        if busy then return end
        if command == nil or string.trim(command) == "" then
            render()
            return
        end
        busy = true
        local function job()
            local ok, err = pcall(execute, command)
            busy = false
            if not ok then
                t:write("\27[1;31m" .. tostring(err) .. "\27[0m\n")
                render()
            end
        end
        local started = false
        if java ~= nil and java.run ~= nil then
            started = pcall(java.run, job, "cterm")
        end
        if not started then job() end
    end

    -- | Synchronous path: used by tests and by anything that already runs off
    -- | the event thread.
    local function submit()
        execute(t:submit())
    end

    local function submitAsync()
        if busy then return end
        local command = t:submit()
        runAsync(command)
    end

    local function complete()
        local input = t.input
        local cursor = t.cursor
        local start = cursor
        while start > 1 do
            local ch = string.sub(input, start - 1, start - 1)
            if ch == " " then break end
            start = start - 1
        end
        local word = string.sub(input, start, cursor - 1)
        if word == "" then return end

        local directory = nil
        local base = word
        local slash = nil
        local position = 1
        while true do
            local found = string.find(word, "/", position, true)
            if found == nil then break end
            slash = found
            position = found + 1
        end

        local candidates = {}
        if start == 1 and slash == nil then
            local entries = io.dirs("/bin")
            for i = 1, #entries do
                local name = entries[i]
                if string.startswith(name, word) then candidates[#candidates + 1] = name end
            end
        else
            if slash ~= nil then
                directory = string.sub(word, 1, slash)
                base = string.sub(word, slash + 1)
            else
                directory = os.getcwd() or "/"
            end
            local entries = io.dirs(directory)
            for i = 1, #entries do
                local name = entries[i]
                if string.startswith(name, base) then candidates[#candidates + 1] = name end
            end
        end

        if #candidates == 0 then return end
        table.sort(candidates)
        local pick = candidates[1]
        for i = 2, #candidates do
            local other = candidates[i]
            local n = 0
            while n < #pick and n < #other and
                string.sub(pick, n + 1, n + 1) == string.sub(other, n + 1, n + 1) do
                n = n + 1
            end
            pick = string.sub(pick, 1, n)
        end

        local suffix = string.sub(pick, #base + 1)
        if suffix ~= "" then t:insertText(suffix) end
        if #candidates == 1 then
            if string.endswith(pick, "/") then
                -- Directory: the slash is already part of the candidate.
            elseif directory ~= nil then
                -- Path completion: leave the cursor ready for more components.
            else
                t:insertText(" ")
            end
        end
    end

    local function openInput()
        local box = graphics.new("edit", "Command", t.input)
        local runCommand = graphics.new("command", { label = "Run", type = "ok", priority = 1 })
        local cancel = graphics.new("command", { label = "Cancel", type = "back", priority = 1 })
        graphics.addCommand(box, runCommand)
        graphics.addCommand(box, cancel)
        graphics.handler(box, {
            [runCommand] = function(text)
                t:setInput(text or "")
                c:display()
                submitAsync()
            end,
            [cancel] = function()
                c:display()
            end
        })
        graphics.display(box)
    end

    local function openHistory()
        if #t.history == 0 then
            t:write("history: empty\n")
            render()
            return
        end
        local list = graphics.new("list", "History")
        local use = graphics.new("command", { label = "Use", type = "ok", priority = 1 })
        local cancel = graphics.new("command", { label = "Cancel", type = "back", priority = 1 })
        for i = #t.history, 1, -1 do
            graphics.append(list, t.history[i])
        end
        graphics.addCommand(list, use)
        graphics.addCommand(list, cancel)
        graphics.handler(list, {
            [use] = function(selected)
                if selected ~= nil and selected ~= "" then
                    t:setInput(tostring(selected))
                end
                c:display()
                render()
            end,
            [cancel] = function()
                c:display()
            end
        })
        graphics.display(list)
    end

    local function onFire()
        if qwerty then
            submitAsync()
        else
            openInput()
        end
    end

    local function onKey(canvas, key, gameAction)
        if gameAction == action.UP then
            t:scrollUp(1)
            render()
        elseif gameAction == action.DOWN then
            t:scrollDown(1)
            render()
        elseif gameAction == action.LEFT then
            t:moveInput(-1)
            render()
        elseif gameAction == action.RIGHT then
            t:moveInput(1)
            render()
        elseif gameAction == action.FIRE then
            onFire()
        elseif gameAction == action.GAME_A then
            t:scrollUp(t.rows - 1)
            render()
        elseif gameAction == action.GAME_B then
            t:scrollDown(t.rows - 1)
            render()
        elseif gameAction == action.GAME_C then
            t:moveHome()
            render()
        elseif gameAction == action.GAME_D then
            t:moveEnd()
            render()
        elseif key == 8 or key == -8 then
            t:bottom()
            t:backspaceInput()
            render()
        elseif key == 127 then
            t:bottom()
            t:deleteInput()
            render()
        elseif key == 9 then
            t:bottom()
            complete()
            render()
        elseif type(key) == "number" and key >= 32 and key <= 126 then
            -- A printable key means the device has a real keyboard, so switch
            -- to direct typing from now on (the mode marker shows abc/123).
            if not qwerty then setQwerty(true, false) end
            t:bottom()
            t:insertChar(string.char(key))
            render()
        end
    end

    local function setFont(index)
        fontIndex = (index - 1) % #FONTS + 1
        measure()
        t:resize(cols, rows)
        drawnRevision = nil
        drawnInput = nil
        render()
    end

    app = {
        canvas = c,
        term = t,
        render = render,
        submit = submit,
        execute = execute,
        key = onKey,
        fire = onFire,
        prompt = promptAnsi,
        promptInfo = promptInfo,
        font = setFont,
        history = openHistory,
        type = openInput,
        qwerty = function(value)
            if value == nil then return qwerty end
            setQwerty(value, false)
            return qwerty
        end,
        cols = cols,
        rows = rows
    }

    c.keyPressed = onKey
    c.keyRepeated = function(canvas, key, gameAction)
        if gameAction ~= action.FIRE then onKey(canvas, key, gameAction) end
    end
    c.pointerPressed = function(canvas, x, y)
        dragging = y
    end
    c.pointerDragged = function(canvas, x, y)
        if dragging == nil then return end
        local delta = y - dragging
        if delta >= lineH then
            t:scrollUp(1)
            dragging = y
            render()
        elseif delta <= -lineH then
            t:scrollDown(1)
            dragging = y
            render()
        end
    end
    c.pointerReleased = function()
        dragging = nil
    end
    c.size = function(canvas, width, height)
        measure()
        if t ~= nil then t:resize(cols, rows) end
        drawnRevision = nil
        drawnInput = nil
        render()
    end

    -- The buffer is recreated with the canvas; a system repaint after the app
    -- comes back must not blit a stale grid.
    c.show = function()
        drawnRevision = nil
        drawnInput = nil
        render()
    end

    c:command("Type", "screen", 1, openInput)
    c:command("Send", "screen", 1, function() submitAsync() end)
    c:command("Switch to...", "screen", 2, function() graphics.taskmngr() end)
    c:command("Hist", "screen", 2, openHistory)
    c:command("Clear", "screen", 3, function()
        t:clear()
        t:clearScrollback()
        render()
    end)
    c:command("Font", "screen", 3, function() setFont(fontIndex + 1) end)
    c:command("QWERTY", "screen", 4, function() setQwerty(not qwerty, true) end)
    c:command("Exit", "screen", 5, closeApp)

    c:display()

    if options.demo then
        t:write("\27[1;36mcterm\27[0m Canvas terminal demo\n")
        t:write("\27[32mgreen\27[0m \27[31mred\27[0m \27[33myellow\27[0m \27[34mblue\27[0m \27[35mmagenta\27[0m \27[36mcyan\27[0m\n")
        t:write("style: \27[1mbold\27[0m \27[4munderline\27[0m \27[7mreverse\27[0m \27[2mdim\27[0m\n")
        t:write("256: \27[38;5;196mred\27[0m \27[38;5;46mgreen\27[0m \27[38;5;21mblue\27[0m\n")
        t:write("truecolour: \27[38;2;255;128;0morange\27[0m\n")
        for i = 1, t.rows + 5 do
            t:write("scrollback line " .. i .. "\n")
        end
        t:scrollUp(3)
        render()
    end

    return app
end

cterm.run = run

-- | Entry point --------------------------------------------------------------

local function main()
    local demo = nil
    if arg ~= nil and arg[1] ~= nil then demo = tonumber(arg[1]) end
    run({ demo = demo ~= nil })
end

if CTERM_AS_MODULE then
    return cterm
end

main()
