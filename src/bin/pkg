#!/bin/lua

local version = "1.6.0"

local server = os.getenv("REPO") or "http://opentty.fun"
if string.startswith(server, "socket://") then
    local address = string.sub(server, 10)
    local port = string.find(address, ":")
    if port then address = string.sub(address, 1, port - 1) end
    server = "http://" .. address
end

local sources = nil

local function current_version()
    return getAppProperty("MIDlet-Version") or os.getenv("VERSION") or "0.0.0"
end

local function major_of(v)
    local parts = string.split(v or "", ".")
    if type(parts) ~= "table" or parts[1] == nil then
        return "0"
    end
    return tostring(parts[1]) .. "." .. tostring(parts[2] or "0")
end

local function current_major()
    return major_of(current_version())
end

local function load_sources()
    local content = io.read("/etc/sources")

    if content ~= "" then
        local data = load(content)

        if type(data) == "table" then
            if type(data.mirror) == "table" then
                if data.version == nil then
                    data.version = current_major()
                end

                return data
            end
        end
    end

    return nil
end

sources = load_sources()

local function require_sources()
    if sources == nil then
        print("pkg: no sources found at /etc/sources")
        print("pkg: run 'pkg update' or 'pkg switch [version]'")
        os.exit(1)
    end
end

local function check_source()
    if sources then
        local sm = major_of(tostring(sources.version))
        local cm = current_major()

        if sm ~= cm then
            print(":: Warning: active source is for OpenTTY " .. tostring(sources.version) .. " (running " .. current_version() .. ")")
            print(":: Packages may not work as expected - run 'pkg update' to refresh the mirror")
        end
    end
end

local function fetch(remote)
    local ok, content, status = pcall(socket.http.get, server .. "/apps/" .. sources.version .. "/" .. remote)

    if ok and status == 200 then
        return content
    else
        return nil
    end
end

local function fetch_file(remote, here)
    local ok, input, status = pcall(socket.http.rget, server .. "/apps/" .. sources.version .. "/" .. remote)

    if ok and status == 200 then
        return io.copy(input, here)
    else
        if ok then
            print(ok, input, status)
        end

        return nil
    end
end

local function install(pkg, verbose)
    if verbose then
        print(":: Installing " .. pkg .. "...")
    end
    
    local info = sources.mirror[pkg]

    if info.depends then
        print(":: Building dependencies")
        for _, dep in ipairs(info.depends) do
            install(dep, verbose)
        end
    end

    local status = fetch_file(info.remote, info.here)

    if status ~= nil then
        if verbose then
            if status == 0 then
                print(":: Installed " .. info.here)
            else
                print(":: Installation error for " .. pkg)
            end
        end

        return status == 0
    else
        if verbose then
            print(":: Connection error")
        end

        return nil
    end
end
local function download(pkg, output)
    local info = sources.mirror[pkg]

    if info then
        local status = fetch_file(info.remote, os.join(output))
        if status == 0 then
            print(":: Downloaded " .. info.remote .. " to " .. output)
        else
            print("download failed")
        end
    else
        print("pkg: download: " .. pkg .. ": not found")
    end
end
local function remove(pkg, verbose)
    if verbose then
        print(":: Removing " .. pkg .. "...")
    end

    local info = sources.mirror[pkg]

    local status = os.remove(info.here)

    if verbose then
        if status == 0 then
            print(":: Removed " .. info.here)
        elseif status == 127 then
            print(":: Package not installed")
        else
            print(":: Removing error for " .. pkg)
        end
    end

    return status == 0
end


os.setproc("name", "pkg")
if arg[1] == nil or arg[1] == "help" then
    print("Yang Package Manager v" .. version)
    print("Usage: pkg <command> [package]")
    print("Commands:")
    print("  install <package>  - Install a package")
    print("  download <package> - Download a package")
    print("  remove <package>   - Remove a package")
    print("  update             - Update sources from the mirror")
    print("  switch <version>   - Switch to another sources version")
    print("  list               - List available packages")
    print("  info <package>     - Show package information")
    print("  help               - Show this help")
elseif arg[1] == "install" then
    if os.getuid() > 0 then print("Permission denied!") os.exit(13) end

    require_sources()

    if arg[2] then
        check_source()

        for i = 2, #arg do
            local pkg = arg[i]

            if sources.mirror[pkg] then
                if sources.mirror[pkg].remote then
                    install(pkg, true)
                else
                    print("pkg: install: " .. pkg .. ": invalid package (not remote source)")
                    os.exit(1)
                end
            elseif pkg == "*" then
                print(":: Installing " .. (#sources.mirror - 4) .. " packages...")
                for pkg2,_ in pairs(sources.mirror) do
                    if sources.mirror[pkg2].remote then
                       install(pkg2, true)
                    end
                end
                return
            else
                print("pkg: install: " .. pkg .. ": not found")
                os.exit(127)
            end
        end
    else
        print("pkg: usage: pkg install [package]")
    end
elseif arg[1] == "download" then
    require_sources()
    check_source()

    if arg[2] and arg[3] then
        download(arg[2], arg[3])
    else
        print("pkg: usage: pkg download [pkg] [file]")
    end
elseif arg[1] == "run" then
    require_sources()
    check_source()

    if arg[2] then
        local file = io.read(os.join(arg[2]))
        if file ~= "" then
            local pkgs = string.split(file, "\n")
            print(":: Installing " .. #pkgs)
            for _,pkg in pairs(pkgs) do
                install(pkg, true)
            end
        else
            print("pkg: nothing to run")
            os.exit(1)
        end
    else
        print("pkg: usage: pkg run [requirements.txt]")
    end
elseif arg[1] == "remove" then
    if os.getuid() > 0 then print("Permission denied!") os.exit(13) end

    require_sources()

    if arg[2] then
        for i = 2, #arg do
            local pkg = arg[i]

            if sources.mirror[pkg] then
                if sources.mirror[pkg].packages then
                    print(":: Removing collection: " .. pkg)
                    print("")

                    local remove_count = 0

                    for _, query in ipairs(sources.mirror[pkg].packages) do
                        if remove(query, false) then
                            remove_count = remove_count + 1
                        end
                    end

                    print(":: Removed " .. remove_count .. " packages from collection '" .. pkg .. "'")
                elseif sources.mirror[pkg].remote then
                    remove(pkg, true)
                else
                    print("pkg: remove: " .. pkg .. ": invalid package")
                    os.exit(2)
                end
            else
                print("pkg: remove: " .. pkg .. ": not found")
                os.exit(127)
            end
        end
    else
        print("pkg: usage: pkg remove [package]")
    end
elseif arg[1] == "update" then
    if os.getuid() > 0 then print("Permission denied!") os.exit(13) end

    local target = current_major()
    if not target or target == "" or target == "0" then target = "1.18" end
    print(":: Updating sources for OpenTTY " .. target .. "...")

    local ok, content, status = pcall(socket.http.get, server .. "/apps/" .. target .. "/sources.lua")

    if ok and status == 200 and content ~= "" then
        if io.write(content, "/etc/sources") == 0 then
            local old = sources ~= nil and sources.version or "none"
            sources = load_sources()

            if sources == nil then
                print("pkg: update: downloaded sources are invalid")
                os.exit(1)
            end

            print(":: Sources updated: " .. tostring(old) .. " -> " .. tostring(sources.version))
        else
            print("pkg: update: could not write /etc/sources")
            os.exit(1)
        end
    else
        print(":: Connection error")
        os.exit(101)
    end

    local ok2, online, status2 = pcall(socket.http.get, server .. "/res/latest")

    if ok2 and status2 == 200 and online and online ~= "" then
        print(":: OpenTTY latest version: " .. tostring(online))
    end
elseif arg[1] == "switch" then
    if os.getuid() > 0 then print("Permission denied!") os.exit(13) end

    if arg[2] then
        local target = arg[2]

        local ok, content, status = pcall(socket.http.get, server .. "/apps/" .. target .. "/sources.lua")

        if ok and status == 200 and content ~= "" then
            if io.write(content, "/etc/sources") == 0 then
                local old = sources ~= nil and sources.version or "none"
                sources = load_sources()

                if sources ~= nil then
                    print(":: Switched sources: " .. tostring(old) .. " -> " .. tostring(sources.version))
                else
                    print("pkg: switch: downloaded sources are invalid")
                    os.exit(1)
                end
            else
                print("pkg: switch: could not write /etc/sources")
                os.exit(1)
            end
        else
            print("pkg: switch: version '" .. target .. "' not found on the mirror")
            os.exit(127)
        end
    else
        require_sources()
        print(":: Active source: OpenTTY " .. tostring(sources.version))
        print("pkg: usage: pkg switch [version]")
    end
elseif arg[1] == "list" then
    require_sources()

    print("Available packages (source " .. tostring(sources.version) .. "):")
    for name, info in pairs(sources.mirror) do
        if not info.packages then
            print("- " .. name .. ": " .. info.description)
        end
    end
elseif arg[1] == "info" then
    require_sources()

    if arg[2] then
        local pkg = arg[2]

        if sources.mirror[pkg] then
            local info = sources.mirror[pkg]
            if info.packages then
            else
                print("Package: " .. pkg)
                print("Description: " .. info.description)
                print("Path: " .. info.here)
                
                if info.depends then
                    print("Dependencies: " .. table.concat(info.depends, ", "))
                end
            end
        else
            print(":: " .. pkg .. " not found")
            os.exit(127)
        end
    else
        print("pkg: usage: pkg info [package]")
    end
else
    print("pkg: " .. arg[1] .. ": not found")
    os.exit(127)
end
